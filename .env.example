# Avalanche Fuji Testnet Configuration
# NEVER commit this file with real values!
# Copy to .env and fill in your values

# RPC endpoint (public, not secret)
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Private key of deployer/operator wallet (NO 0x prefix)
# Generate a fresh wallet for this project ONLY
PRIVATE_KEY=

# Chain ID for Fuji
CHAIN_ID=43113

# Contract addresses (filled after deployment)
TOKEN_CONTRACT_ADDRESS=
HUB_CONTRACT_ADDRESS=

# Demo safety: set to "true" to mock chain calls (no real transactions)
MOCK_CHAIN=false

# Snowtrace API key for contract verification (optional)
SNOWTRACE_API_KEY=

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3000
NODE_ENV=development